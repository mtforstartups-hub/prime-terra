# ─────────────────────────────────────────────────────────────────────────────
# Nodemailer / Contact Form Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# For Plesk: set these as Environment Variables inside the Node.js app settings.
# NEVER commit .env.local to Git.
# ─────────────────────────────────────────────────────────────────────────────

# Your Plesk hosting SMTP server (usually your hosting domain or mail.yourdomain.com)
SMTP_HOST=mail.yourdomain.com

# 465 for SSL (recommended), 587 for TLS/STARTTLS
SMTP_PORT=465

# true for port 465 (SSL), false for port 587 (STARTTLS)
SMTP_SECURE=true

# The email account you created in Plesk — this is what you LOG IN with
SMTP_USER=info@yourdomain.com

# The password for the above email account in Plesk
SMTP_PASS=your-email-password-here

# Where form submissions should be delivered.
# You can add multiple emails separated by commas:
# e.g.  info@yourdomain.com,director@yourdomain.com
CONTACT_FORM_RECIPIENTS=info@yourdomain.com
